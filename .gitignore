# The source manuscript is unpublished and belongs to its authors; it is not
# committed to this public repository.  Everything recovered from it that the
# code depends on is recorded in the paper's appendices instead.
Discrimination2025*.pdf
paper/draft.pdf
dissertacao*.pdf

# Simulation caches: regenerate with `python scripts/make_all.py --preset <p>`.
nn-based-simulation/data/
# Built by scripts/draft_comparison.py, and only meaningful next to the source PDF.
nn-based-simulation/figures/draft_comparison.pdf

# LaTeX build artefacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.synctex(busy)
*.toc
# The paper's figures ARE committed, even though `make figures` regenerates them
# from nn-based-simulation.  They are small, and committing them means a coauthor who
# clones the repo and hits compile in an editor gets a paper, rather than fourteen
# missing-file errors and a hunt for the Makefile.  Do not add paper/figures/ here.

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# macOS
.DS_Store

# Scratch logs from long runs
.fullrun.log
.sweep*.log
.calibrate.log
.nscan.log

# API credentials.  Never commit.
.env

# LLM response cache: 57 MB of raw API responses, keyed by prompt hash.
# Regenerate by rerunning the stages; deleting it only costs money, not data.
llm-agent-modulation/data/cache/

# Sweep caches for the directional-field exploration: regenerate with
# `python scripts/make_all.py --preset <p>`.
directional-prejudice/data/
directional-prejudice/.medium.log

# Same, for the uniform-credulity plane.  The `full` sweep is ~6 MB of npz and
# four hours of compute; it is a cache, not a source, and `--preset full`
# rebuilds it.
uniform-credulity/data/
uniform-credulity/.*.log

# Same, for the credulity-asymmetry plane.  The `full` sweep is five strip caches
# totalling ~3.6 MB and six and three quarter hours of compute; it is a cache,
# not a source, and `--preset full` rebuilds it (reloading whichever strips are
# already there).
credulity-asymmetry/data/
credulity-asymmetry/.*.log
